+/* Idea 2: the places sit between where you are and the clock. */
+.pico-status-bar-places {
+	display: flex;
+	gap: calc(var(--pico-px) * 3);
+	margin-left: auto;
+	align-self: center;
+}
+
+.pico-status-bar-place-entry {
+	padding: 0 calc(var(--pico-px) * 3);
+	font: inherit;
+	font-size: var(--pico-text-sm);
+	line-height: calc(var(--pico-px) * 9);
+	color: var(--pico-plate-ink);
+	background: var(--pico-plate);
+	border: 0;
+}
+
+.pico-status-bar-place-entry[aria-current="page"] {
+	color: var(--pico-go-ink);
+	background: var(--pico-go);
+}
+
 .pico-status-bar-label {
 	color: var(--pico-accent);
 }
