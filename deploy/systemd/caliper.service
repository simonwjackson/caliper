[Unit]
Description=Caliper app: the chrome and take agents for every running Caliper dev server (decision 37)
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# deploy/install.sh writes the path of the checkout it runs from into WorkingDirectory.
# The app reads its settings from ~/.config/caliper/config.json and the registry from $XDG_RUNTIME_DIR/caliper/servers/, which systemd sets for user
# units and empties at reboot (decision 39). `nix develop` supplies CHROMIUM.
WorkingDirectory=@CHECKOUT@
ExecStart=/run/current-system/sw/bin/nix develop --command node bin/caliper.mjs --port 3132 --host 127.0.0.1
Restart=on-failure
RestartSec=3
# The app starts a headless Chromium for each agent render.
MemoryHigh=2500M
MemoryMax=4G
CPUQuota=200%
TasksMax=512
LimitNOFILE=65536
TimeoutStopSec=20

[Install]
WantedBy=default.target
