{
  "name": "@simonwjackson/caliper",
  "version": "0.1.0",
  "description": "A dev-only Vite plugin that renders a project's own UI parts at true physical device size.",
  "license": "MIT",
  "author": "Simon W. Jackson",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonwjackson/caliper.git"
  },
  "exports": {
    ".": {
      "types": "./src/plugin.d.ts",
      "default": "./src/plugin.js"
    },
    "./checks": {
      "types": "./src/authored/checks.d.ts"
    }
  },
  "bin": {
    "caliper": "./bin/caliper.mjs",
    "caliper-render": "./bin/caliper-render.mjs"
  },
  "files": [
    "src",
    "bin",
    "skills",
    "dist/chrome"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-chrome.mjs",
    "prepack": "bun run build",
    "tool:install": "node scripts/chrome-tool.mjs",
    "tool:app": "node scripts/tool-app.mjs",
    "app": "node bin/caliper.mjs",
    "verify:chrome-delivery": "node scripts/verify-chrome-delivery.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:chrome-contract": "node scripts/verify-chrome-contract.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@lezer/highlight": "1.2.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@types/chai": "5.2.3",
    "@vitest/expect": "4.1.10",
    "axe-core": "4.13.0",
    "chai": "6.2.2",
    "playwright-core": "1.59.1",
    "postcss": "8.5.28",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typebox": "1.3.27",
    "typescript": "~5.9.3",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "6.4.2"
  }
}
